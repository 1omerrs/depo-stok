# sqlite | airtable | auto (anahtar varsa Airtable, yoksa SQLite)
DATA_BACKEND=auto
SQLITE_PATH=./data/warehouse.db

# Airtable — tablolar: products, locations, stock, orders, returns
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_PRODUCTS=products
AIRTABLE_TABLE_LOCATIONS=locations
AIRTABLE_TABLE_STOCK=stock
AIRTABLE_TABLE_ORDERS=orders
AIRTABLE_TABLE_RETURNS=returns

# Panel girişi. Varsayılan geliştirme parolası: admin / depo-panel
PANEL_USERNAME=admin
PANEL_PASSWORD=depo-panel
PANEL_SECRET=

# E-postadaki onay linklerinin kök adresi
PUBLIC_BASE_URL=http://127.0.0.1:8000
NOTIFY_EMAIL=depo@example.com

# İsteğe bağlı. Doluysa webhook isteklerinde X-Webhook-Token başlığı aranır.
WEBHOOK_SECRET=

# İade fiziksel kontrol mailini n8n'e bırakmak için (opsiyonel)
N8N_INSPECT_WEBHOOK=
# Yönetici üyeyi onaylayınca bu n8n formu çalışır: tabloya yazar, onay mailini gönderir
N8N_SIGNUP_FORM=http://localhost:5678/form/depo-uye-ol
# Üye onaylanınca n8n bu adrese POST atar ve onay mailini gönderir
N8N_APPROVAL_WEBHOOK=

# Tam eşleşme yoksa AI. Boşsa çevrimdışı benzerlik eşlemesi kullanılır.
AUTO_MATCH_THRESHOLD=90
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=auto
